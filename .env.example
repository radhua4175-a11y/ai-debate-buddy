# Supabase (Project Settings -> API). Use the publishable/anon key, never the service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Vercel AI Gateway key (not needed on Vercel, which uses OIDC automatically).
AI_GATEWAY_API_KEY=
# Optional: any "provider/model" string supported by the AI Gateway.
AI_MODEL=anthropic/claude-haiku-4.5
